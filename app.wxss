/* Global styles for mini program - adapt from css/style.css (partial) */
page { background: #0a0e17; color: #c0d0e0; }
.app { padding: 12px 16px; }
.brand-icon { width:36px; height:36px; border-radius:8px; background:linear-gradient(135deg,#3a7bd5,#5b9bd5); display:flex; align-items:center; justify-content:center; font-size:20px; }
.pill { font-size:12px; color:#667a90; background:#0c1220; padding:6px 10px; border-radius:12px; }
.footer { font-size:12px; color:#667a90; text-align:center; margin-top:12px; }
.search-box { display:flex; align-items:center; gap:6px; background:#0c1220; border-radius:20px; padding:8px 12px; }
.btn { background:#0b1220; color:#c0d0e0; padding:6px 10px; border-radius:8px; }
.chart-wrap { background:#0c1220; border-radius:12px; padding:8px; margin-top:8px; }
