.title { font-size:16px; color:#c0d0e0; font-weight:700; }
.subtitle { font-size:12px; color:#667a90; }
.brand { display:flex; gap:10px; align-items:center; margin-bottom:8px; }
.search-box { display:flex; gap:8px; align-items:center; margin-bottom:8px; }

.loc-field { flex:1; min-width:0; display:flex; flex-direction:column; justify-content:center; }
.loc-name {
  font-size:14px; color:#c0d0e0; font-weight:600;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}
.loc-hint { font-size:10px; color:#667a90; margin-top:2px; }
.locate-btn {
  width:36px; height:36px; padding:0; border:0;
  display:flex; align-items:center; justify-content:center;
}
.locate-btn::after { border:0; }
.locate-mark {
  width:18px; height:18px; position:relative; box-sizing:border-box;
  border:2px solid #aac8e0; border-radius:50%;
}
.locate-mark::before, .locate-mark::after {
  content:""; position:absolute; background:#aac8e0;
}
.locate-mark::before {
  width:2px; height:24px; left:6px; top:-5px;
}
.locate-mark::after {
  width:24px; height:2px; left:-5px; top:6px;
}
.locate-center {
  position:absolute; z-index:1; width:6px; height:6px;
  left:4px; top:4px; border-radius:50%; background:#5b9bd5;
  border:1px solid #0b1220;
}

/* 数据源切换胶囊 */
.source-row {
  display:flex; align-items:center; gap:10px;
  width:100%; margin-bottom:8px;
}
.src-toggle {
  display:inline-flex; align-items:center;
  flex:none; background:#0c1220; border-radius:999px; padding:3px;
  border:1px solid rgba(120,160,200,0.14);
}
.src-seg {
  padding:5px 20px; border-radius:999px;
  font-size:12px; color:#667a90; line-height:1.2;
  transition: background .18s ease, color .18s ease;
}
.src-seg.active {
  background:linear-gradient(135deg,#3a7bd5,#5b9bd5);
  color:#ffffff; font-weight:700;
}
.range-inline {
  display:flex; align-items:center; gap:4px; min-width:0; margin-left:auto;
  color:#667a90; font-size:12px; white-space:nowrap;
}
.range-inline text:last-child {
  overflow:hidden; text-overflow:ellipsis;
}
.chart-wrap { margin-top:8px; position:relative; }

.main-canvas { display:block; width:100%; background:#0a1020; border-radius:8px; }

.loading {
  position:absolute; left:0; right:0; top:10px;
  text-align:center; color:#aac8e0; font-size:12px;
}

/* 云层高度备注 */
.cloud-legend {
  display:flex; align-items:center; justify-content:space-between; gap:6px;
  margin-top:8px; padding:6px 10px;
  background:#0c1220; border-radius:8px;
}
.legend-item { display:flex; align-items:center; gap:4px; min-width:0; }
.legend-dot { width:8px; height:8px; border-radius:2px; flex:none; }
.legend-dot.low { background:#5b9bd5; }
.legend-dot.mid { background:#9b7bd5; }
.legend-dot.high { background:#e8f0fa; }
.legend-name { font-size:11px; color:#aac8e0; }
.legend-alt { font-size:11px; color:#667a90; }
.legend-note {
  font-size:10px; color:#556680; line-height:1.5;
  margin-top:6px; padding:0 2px;
}
