<view class="app">
  <view class="brand">
    <view class="brand-icon">🔥</view>
    <view>
      <view class="title">火烧云预测</view>
      <view class="subtitle">朝霞 · 晚霞 出现概率与燃烧程度</view>
    </view>
  </view>

  <view class="info top-info">
    <view class="pill location-pill">📍 <text class="location-name">{{locName}}</text></view>
    <view class="source-switch">
      <view class="source-option {{dataSource === 'ec' ? 'active' : ''}}" data-src="ec" bindtap="onSwitchSource">ECMWF</view>
      <view class="source-option {{dataSource === 'gfs' ? 'active' : ''}}" data-src="gfs" bindtap="onSwitchSource">GFS</view>
    </view>
  </view>

  <view class="day-switch">
    <view class="day-option {{selectedDay === 'today' ? 'active' : ''}}" data-day="today" bindtap="selectDay">今日</view>
    <view class="day-option {{selectedDay === 'tomorrow' ? 'active' : ''}}" data-day="tomorrow" bindtap="selectDay">明日</view>
  </view>

  <view class="state" wx:if="{{loading}}">预测中...</view>
  <view class="state err" wx:elif="{{error}}">{{error}}</view>

  <block wx:else>
    <view class="card {{item.tone}}" wx:for="{{sections}}" wx:for-item="item" wx:key="key">
      <view class="card-head">
        <view class="card-icon">{{item.icon}}</view>
        <view class="card-title">
          <view class="ct-main">{{item.label}}</view>
          <view class="ct-sub">{{item.dateLabel}} {{item.timeLabel}}</view>
          <view class="ct-expected">预计时间 {{item.expectedTimeLabel}}</view>
        </view>
        <view class="badge">{{item.probLevel}}</view>
      </view>

      <view class="metrics">
        <view class="metric">
          <view class="m-val">{{item.probPct}}<text class="m-unit">%</text></view>
          <view class="m-label">出现概率</view>
          <view class="bar"><view class="bar-fill" style="width:{{item.probPct}}%"></view></view>
        </view>
        <view class="metric">
          <view class="m-val">{{item.intensity}}<text class="m-unit">/5</text></view>
          <view class="m-label">燃烧程度 · {{item.intensityLabel}}</view>
          <view class="dots">
            <view class="dot {{dot.on ? 'on' : ''}}" wx:for="{{item.dots}}" wx:for-item="dot" wx:key="i"></view>
          </view>
        </view>
      </view>

      <view class="detail">
        <view class="d-row {{ri % 2 === 0 ? 'd-l' : 'd-r'}}" wx:for="{{item.rows}}" wx:for-item="row" wx:for-index="ri" wx:key="k">
          <text class="d-k">{{row.k}}</text>
          <text class="d-v">{{row.v}}</text>
        </view>
      </view>

      <view class="judge">
        <view class="j-item {{j.wide ? 'j-wide' : ''}}" wx:for="{{item.judge}}" wx:for-item="j" wx:key="k">
          <text class="j-k">{{j.k}}</text>
          <text class="j-v">{{j.v}}</text>
        </view>
      </view>
    </view>
  </block>

  <!-- <view class="footer">数据来自 Open-Meteo · Copyright © Yifeng </view> -->
  <view class="footer">Copyright © Yifeng </view>
</view>
